# ==============================================================================
# MUCAMBO NEXUS - CONFIGURAÇÕES DO MODO REAL (PRODUÇÃO)
# ==============================================================================
# Alterne para False para operar com dinheiro e transações reais
SIMULATION_MODE=true

# Margem mínima de lucro exigida pelo robô (em %)
MIN_PROFIT_MARGIN_PERCENT=30.0
# Lucro líquido mínimo por operação em Dólares (USD)
MIN_NET_PROFIT_USD=15.0

# ------------------------------------------------------------------------------
# 1. GATEWAY DE PAGAMENTO (Para receber do comprador final antes de comprar)
# ------------------------------------------------------------------------------
# Stripe (Cartão de Crédito Global / Apple Pay)
STRIPE_SECRET_KEY=sk_live_sua_chave_aqui
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_webhook_aqui

# Mercado Pago (Para recebimento instantâneo via PIX no Brasil)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-token-aqui

# ------------------------------------------------------------------------------
# 2. CONECTORES DA FONTE DE ATIVOS INTANGÍVEIS (Onde o robô compra no JIT)
# ------------------------------------------------------------------------------
# Provedores de Domínio (Para compra instantânea de domínios aprovados)
NAMECHEAP_API_USER=seu_usuario
NAMECHEAP_API_KEY=sua_chave_api_namecheap
NAMECHEAP_CLIENT_IP=seu_ip_publico

# Provedores de IA & Dados (Para geração de micro-serviços B2B com custo de centavos)
OPENAI_API_KEY=sk-proj-sua-chave-openai
DEEPSEEK_API_KEY=sua-chave-deepseek

# ------------------------------------------------------------------------------
# 3. CONEXÃO CRIPTO / WEB3 (Para liquidação de spreads preditivos)
# ------------------------------------------------------------------------------
POLYMARKET_API_KEY=sua_chave_polymarket
WEB3_PRIVATE_KEY=sua_private_key_polygon_usdc
